{
  "name": "送信登記",
  "short_name": "送信登記",
  "description": "租屋代管：送催繳信登記、傳簡訊、工作日誌",
  "start_url": "./send.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef0ec",
  "theme_color": "#1c6b8f",
  "lang": "zh-Hant",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "id": "./send.html",
  "share_target": {
    "action": "./send.html?share=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "*/*"
          ]
        }
      ]
    }
  }
}
